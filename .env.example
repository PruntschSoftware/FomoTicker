# --- Pflicht ---------------------------------------------------------------
# Railway: Postgres-Service hinzufügen, dann hier ${{Postgres.DATABASE_URL}} referenzieren
DATABASE_URL=postgresql://user:pass@host:5432/railway
# Öffentliche Adresse dieses Services (Railway > Settings > Networking > Generate Domain)
PUBLIC_URL=https://aktien-ticker.up.railway.app

# Abo-Modus: false = App kostenlos (Start). true = Testzeit + Stripe-Abo.
# Beim ersten Start mit true bekommen alle Bestandsnutzer einmalig volle Testtage.
PAYWALL_ENABLED=false

# Stripe – nur nötig mit PAYWALL_ENABLED=true
# (Dashboard > Entwickler > API-Schlüssel / Webhooks; Preis = 1 €/Monat, wiederkehrend)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Kursdaten – Anbieter in Reihenfolge der Priorität. Für Kurse, Charts und Suche wird
# jeweils der erste genommen, der Zugangsdaten hat und die Aufgabe kann.
# Verfügbar: alpaca, eodhd, twelvedata, finnhub, mock (Spieldaten). Neuer Anbieter: providers.js
PROVIDERS=alpaca,twelvedata
# Twelve Data (twelvedata.com) – Basic gratis: 8/min, 800/Tag, ohne Vor-/Nachbörse
TWELVEDATA_API_KEY=...
# Alpaca (alpaca.markets) – Basic gratis: 200/min, kein Tageslimit, inkl. Vor-/Nachbörse (IEX)
ALPACA_KEY_ID=...
ALPACA_SECRET_KEY=...
# Finnhub (finnhub.io) – Free: 60/min, nur Kurse + Suche
FINNHUB_API_KEY=...
# EODHD (eodhd.com) – Europa: Xetra, Frankfurt, Stuttgart, München, Wien, Schweiz, Euronext,
# Mailand, London …, 15–20 Min verzögert (Bezahlplan). In PROVIDERS hinter alpaca setzen:
#   PROVIDERS=alpaca,eodhd,twelvedata  -> US-Werte über Alpaca, Europa über EODHD
EODHD_API_KEY=...
# EODHD_EXCHANGES=XETRA,F,STU,MU,VI,SW,PA,AS,MI,LSE   # Börsen für die Suche

# --- Optional --------------------------------------------------------------
# Kurze Adresse, die die Uhr zum Aktivieren anzeigt (Railway-Domains sind zu lang
# fürs Display). Eigene Domain in Railway > Settings > Networking > Custom Domain.
DISPLAY_URL=ticker.deinname.at
# Stripe-Kundenportal (Einstellungen > Billing > Kundenportal > Login-Link)
STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...
STRIPE_AUTOMATIC_TAX=false         # true, sobald Stripe Tax eingerichtet ist (EU-USt / OSS)
STRIPE_REQUIRE_TERMS=false         # true = AGB-Häkchen im Checkout (AGB-URL in Stripe hinterlegen)

IMPRINT_URL=https://...
PRIVACY_URL=https://...
TERMS_URL=https://...

TRIAL_DAYS=7
QUOTE_CACHE_SECONDS=60
SERIES_CACHE_SECONDS=900
# Limits je Anbieter überschreiben: <ANBIETER>_PER_MINUTE / <ANBIETER>_PER_DAY (0 = unbegrenzt)
TWELVEDATA_PER_MINUTE=8           # (alt: CREDITS_PER_MINUTE)
TWELVEDATA_PER_DAY=800            # (alt: CREDITS_PER_DAY)
# Aufgabe fest einem Anbieter zuordnen (optional)
# QUOTES_PROVIDER=alpaca  SERIES_PROVIDER=alpaca  DIRECTORY_PROVIDER=twelvedata
ALPACA_FEED=iex                   # sip nur mit bezahltem Alpaca-Plan
DIRECTORY_MARKETS=us              # us (Basic) oder all (ab Grow: Xetra, Wien, London …)
BATCH_SIZE=8
PRICE_LABEL=1 € / Monat
DATABASE_SSL=false                 # true nur bei externer DB mit SSL-Pflicht
